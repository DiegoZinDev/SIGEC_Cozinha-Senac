<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" stylesheets="@CSS/StyleSheet.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigec.system.sigec.Controllers.ListaController">
    <top>
        <AnchorPane fx:id="topBarPane" prefHeight="50.0" style="-fx-background-color: #0b2647;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="35.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <ImageView fitHeight="42.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/LogocoloridaSenac.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label text="S.I.G.E.C" textFill="WHITE">
                            <font>
                                <Font name="Arial Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </top>
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="200.0" styleClass="painel-lateral" BorderPane.alignment="CENTER">
            <children>
                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickHome" styleClass="btn-padrao" text="Página Inicial">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/home.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" top="20.0" />
                    </VBox.margin>
                </Button>
                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" styleClass="btn-padrao" text="Estoque">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/estoque.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickRelatorio" styleClass="btn-padrao" text="Relatório">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickCadastro" styleClass="btn-padrao" text="Cadastro">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/cadastroIMG.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="botaoSair" alignment="CENTER" mnemonicParsing="false" onAction="#botaoSairAction" styleClass="btn-sair" text="Sair">
                            <font>
                                <Font name="Arial Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" left="15.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane prefHeight="550.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="400.0" fitWidth="400.0" opacity="0.12" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/LogocoloridaSenac.png" />
                    </image>
                </ImageView>
                <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="600.0" style="-fx-border-color: #054584; -fx-border-width: 0 0 0 1;">
                    <children>
                        <HBox alignment="CENTER" prefHeight="50.0" styleClass="painel-secundario">
                            <children>
                                <Label fx:id="dataLabel" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="usuarioLabel" text="Administrador" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="horaLabel" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="10.0">
                            <children>
                                <TextField fx:id="FiltrarProdutos" prefHeight="32.0" prefWidth="200.0" promptText="🔍 Buscar no estoque...">
                                    <font>
                                        <Font name="Arial" size="13.0" />
                                    </font>
                                </TextField>
                                <Button mnemonicParsing="false" onAction="#onPesquisarClick" prefHeight="32.0" prefWidth="95.0" styleClass="btn-padrao-2" text="Pesquisar">
                                    <font>
                                        <Font name="Arial Bold" size="12.0" />
                                    </font>
                                </Button>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button alignment="CENTER" graphicTextGap="6.0" mnemonicParsing="false" onAction="#onClickAddProduto" prefHeight="32.0" prefWidth="110.0" styleClass="btn-padrao-2" text="Adicionar">
                                    <graphic>
                                        <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@imagens/mais.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                    <font>
                                        <Font name="Arial Bold" size="12.0" />
                                    </font>
                                </Button>
                                <Button fx:id="editar" mnemonicParsing="false" onAction="#onEditarProduto" prefHeight="32.0" prefWidth="85.0" styleClass="btn-padrao-2" text="Editar">
                                    <font>
                                        <Font name="Arial Bold" size="12.0" />
                                    </font>
                                </Button>
                                <Button fx:id="remover" mnemonicParsing="false" onAction="#onRemoverProdutoClick" prefHeight="32.0" prefWidth="85.0" styleClass="btn-padrao-2" text="Excluir">
                                    <font>
                                        <Font name="Arial Bold" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                            <VBox.margin>
                                <Insets left="20.0" right="20.0" top="15.0" />
                            </VBox.margin>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" prefHeight="25.0" spacing="15.0">
                            <children>
                                <CheckBox fx:id="chkPereciveis" mnemonicParsing="false" text="Perecível">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </CheckBox>
                                <CheckBox fx:id="chkNaoPereciveis" mnemonicParsing="false" text="Não Perecível">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </CheckBox>
                                <CheckBox fx:id="chkUtensilios" mnemonicParsing="false" text="Utensílios">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </CheckBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                            </VBox.margin>
                        </HBox>
                        <TableView fx:id="ListaEstoque" prefHeight="380.0" prefWidth="560.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="nomeProduto" prefWidth="220.0" text="Produtos" />
                                <TableColumn fx:id="tipoProduto" prefWidth="140.0" text="Tipo" />
                                <TableColumn fx:id="quantidadeProduto" prefWidth="100.0" text="Quantidade" />
                                <TableColumn fx:id="unidadeProduto" prefWidth="100.0" text="Unidade" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <VBox.margin>
                                <Insets bottom="20.0" left="20.0" right="20.0" />
                            </VBox.margin>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>

