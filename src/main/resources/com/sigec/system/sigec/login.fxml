                        <Font name="Arial Bold" size="12.0" />
                     </font>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                     <padding>
                        <Insets right="-391.0" />
                     </padding>
                      </Hyperlink>
               </children></HBox>
                <Button fx:id="btnlogin" mnemonicParsing="false" onAction="#onButtonLoginClick" prefHeight="26.0" prefWidth="110.0" styleClass="btn-laranja" text="ENTRAR">
                    <VBox.margin>
                        <Insets top="17.0" />
                    </VBox.margin>
                </Button>
            <HBox alignment="CENTER" prefHeight="43.0" prefWidth="800.0">
               <children>
                  <Label text="Não tenho uma conta?">
