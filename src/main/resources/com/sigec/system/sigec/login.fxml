                        <Insets top="15.0" />
                    </VBox.margin>
                    <font>
                        <Font name="SansSerif Bold" size="18.0" />
                    </font>
                </Label>
                <Label alignment="TOP_CENTER" graphicTextGap="0.0" prefHeight="19.0" prefWidth="500.0" text="E-mail" textOverrun="CENTER_ELLIPSIS">
                    <VBox.margin>
                        <Insets top="50.0" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="4.0" left="-460.0" />
