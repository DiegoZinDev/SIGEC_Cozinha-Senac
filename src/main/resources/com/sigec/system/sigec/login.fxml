            <HBox alignment="CENTER" prefHeight="27.0" prefWidth="800.0">
               <children>
                      <Hyperlink fx:id="lbesquecisenha" alignment="CENTER" onAction="#EsqueciSenha" prefHeight="23.0" prefWidth="504.0" text="Esqueceu a senha?" textFill="#1b7ee3" textOverrun="CLIP">
