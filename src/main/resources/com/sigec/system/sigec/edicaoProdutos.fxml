<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="500.0" stylesheets="@css/estilo2.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.desktop_cozinha.controller.EdicaoProdutosController">
    <center>
        <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="333.0" fitWidth="320.0" opacity="0.3" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/LogocoloridaSenac.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <Label alignment="CENTER" contentDisplay="CENTER" graphicTextGap="0.0" text="EDITAR PRODUTOS">
                            <font>
                                <Font name="Arial Bold" size="20.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="30.0" top="10.0" />
                            </VBox.margin>
                        </Label>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="500.0">
                           <children>
                                    <TextField fx:id="txtNomeProduto" promptText="NOME DO PRODUTO">
                                        <VBox.margin>
                                            <Insets bottom="30.0" />
                                        </VBox.margin>
                                        <font>
                                            <Font name="Arial" size="12.0" />
                                        </font>
                                    </TextField>
                                    <TextField fx:id="txtQtdAtual" promptText="QUANTIDADE ATUAL">
                                        <font>
                                            <Font name="Arial" size="12.0" />
                                        </font>
                                        <VBox.margin>
                                            <Insets bottom="30.0" />
                                        </VBox.margin>
                                    </TextField>
                                    <TextField fx:id="txtEstoqueMinimo" promptText="ESTOQUE MINIMO">
                                        <font>
                                            <Font name="Arial" size="12.0" />
                                        </font>
                                        <VBox.margin>
                                            <Insets bottom="20.0" />
                                        </VBox.margin>
                                    </TextField>
                           </children>
                        </VBox>
                     </children>
                     <VBox.margin>
                        <Insets left="75.0" right="75.0" />
                     </VBox.margin>
                  </HBox>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label alignment="CENTER" contentDisplay="TOP" text="TIPO PRODUTO " textOverrun="CLIP">
                                    <HBox.margin>
                                        <Insets />
                                    </HBox.margin>
                                    <font>
                                        <Font name="Arial Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ChoiceBox fx:id="txtTipoProduto" prefWidth="100.0">
                                    <HBox.margin>
                                        <Insets left="65.0" />
                                    </HBox.margin>
                                </ChoiceBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" left="75.0" right="75.0" />
                            </VBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label text="UNIDADE DE MEDIDA">
                                    <font>
                                        <Font name="Arial Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ChoiceBox fx:id="txtUnidadeDeMedida" prefWidth="100.0">
                                    <HBox.margin>
                                        <Insets left="30.0" />
                                    </HBox.margin>
                                </ChoiceBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" left="75.0" right="75.0" />
                            </VBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label text="DATA DE VALIDADE ">
                                    <font>
                                        <Font name="Arial Bold" size="13.0" />
                                    </font>
                                </Label>
                                <DatePicker fx:id="txtDataValidade" prefWidth="100.0">
                                    <HBox.margin>
                                        <Insets left="30.0" />
                                    </HBox.margin>
                                </DatePicker>
                            </children>
                     <VBox.margin>
                        <Insets bottom="20.0" left="75.0" right="75.0" />
                     </VBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="40.0">
                            <VBox.margin>
                                <Insets bottom="30.0" left="75.0" right="75.0" />
                            </VBox.margin>
                            <children>
                                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltarTela" styleClass="btn-padrao-2" text="VOLTAR">
                                    <HBox.margin>
                                        <Insets right="100.0" />
                                    </HBox.margin>
                                </Button>
                                <Button fx:id="btnCadastro" mnemonicParsing="false" onAction="#onEditar" styleClass="btn-padrao-2" text="EDITAR">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
