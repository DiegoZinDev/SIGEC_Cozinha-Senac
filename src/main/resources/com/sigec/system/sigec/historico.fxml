<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" stylesheets="@CSS/StyleSheet.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigec.system.sigec.Controllers.HistoricoController">
    <top>
        <AnchorPane fx:id="topBarPane" prefHeight="50.0" prefWidth="800.0" style="-fx-background-color: #f6f8fb;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="35.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <ImageView fitHeight="42.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/LogocoloridaSenac.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label text="S.I.G.E.C" textFill="WHITE">
                            <font>
                                <Font name="Arial Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </top>
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="200.0" styleClass="painel-lateral" BorderPane.alignment="CENTER">
            <children>
                <Button id="btnNavHome" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickHome" styleClass="btn-padrao" text="Página Inicial">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/home.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" top="20.0" />
                    </VBox.margin>
                </Button>
                <Button id="btnNavEstoque" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickEstoque" styleClass="btn-padrao" text="Estoque">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/estoque.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <Button id="btnNavRelatorio" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" text="Relatório">
                    <styleClass>
                        <String fx:value="btn-padrao" />
                        <String fx:value="btn-ativo" />
                    </styleClass>
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <!-- Container do Menu Dropdown de Cadastro -->
                <VBox alignment="TOP_CENTER" spacing="0.0">
                    <children>
                        <Button id="btnNavCadastro" fx:id="btnNavCadastro" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#toggleDropdownCadastro" styleClass="btn-padrao">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                               <Image url="@imagens/cadastroIMG.png" />
                                            </image>
                                            <effect>
                                                <ColorAdjust brightness="1.0" />
                                            </effect>
                                        </ImageView>
                                        <Label text="Cadastros" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="setaCadastro" text="▼" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="11.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Submenu com as opções de cadastro (inicialmente recolhido) -->
                        <VBox fx:id="submenuCadastro" alignment="TOP_CENTER" managed="false" spacing="0.0" styleClass="submenu-lateral" visible="false">
                            <children>
                                <Button id="btnSubNavUsuario" fx:id="btnSubNavUsuario" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickCadastroUsuario" styleClass="btn-sub-opcao" text="Cadastro Usuário">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </graphic>
                                </Button>
                                <Button id="btnSubNavTurma" fx:id="btnSubNavTurma" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickCadastroTurma" styleClass="btn-sub-opcao" text="Cadastro Turma">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="botaoSair" alignment="CENTER" mnemonicParsing="false" onAction="#botaoSairAction" styleClass="btn-sair" text="Sair">
                            <font>
                                <Font name="Arial Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" left="15.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane prefHeight="550.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="400.0" fitWidth="400.0" opacity="0.12" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/LogocoloridaSenac.png" />
                    </image>
                </ImageView>
                <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="600.0" style="-fx-border-color: #054584; -fx-border-width: 0 0 0 1;">
                    <children>
                        <HBox alignment="CENTER" prefHeight="50.0" styleClass="painel-secundario">
                            <children>
                                <Label fx:id="dataLabel" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="usuarioLabel" text="Administrador" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="horaLabel" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                        <VBox fx:id="conteudoPagina" styleClass="conteudo-pagina" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="45.0" spacing="12.0">
                                    <children>
                                        <TextField fx:id="txtpesquisa" prefHeight="35.0" prefWidth="220.0" promptText="🔍 Pesquisar..." styleClass="search-field">
                                            <font>
                                                <Font name="Arial" size="13.0" />
                                            </font>
                                        </TextField>
                                        <Button fx:id="btnbuscardata" mnemonicParsing="false" onAction="#filtrarHistorico" prefHeight="35.0" prefWidth="95.0" styleClass="btn-action-primary" text="Filtrar">
                                            <font>
                                                <Font name="Arial Bold" size="13.0" />
                                            </font>
                                        </Button>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <DatePicker fx:id="dataDE" prefHeight="35.0" prefWidth="140.0" promptText="De" styleClass="custom-date-picker" />
                                        <DatePicker fx:id="dataATE" prefHeight="35.0" prefWidth="140.0" promptText="Até" styleClass="custom-date-picker" />
                                        <ChoiceBox fx:id="filtro" prefHeight="35.0" prefWidth="135.0" styleClass="custom-choice-box" />
                                    </children>
                                    <VBox.margin>
                                        <Insets left="20.0" right="20.0" top="15.0" />
                                    </VBox.margin>
                                </HBox>
                                <TableView fx:id="tableHistorico" prefHeight="390.0" prefWidth="560.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="data_hora" prefWidth="100.0" text="Data/Hora" />
                                        <TableColumn fx:id="nome_produto" prefWidth="150.0" text="Produto" />
                                        <TableColumn fx:id="tipo_estoque" prefWidth="90.0" text="Tipo" />
                                        <TableColumn fx:id="quantidade" prefWidth="60.0" text="Qtd" />
                                        <TableColumn fx:id="tipo_movimentacao" prefWidth="90.0" text="Movimentação" />
                                        <TableColumn fx:id="nome_usuario" prefWidth="110.0" text="Usuário" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <VBox.margin>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="12.0" />
                                    </VBox.margin>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>

